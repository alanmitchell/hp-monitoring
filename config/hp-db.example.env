# Copy to config/hp-db.env (ignored by git), set a real token, then: chmod 600 config/hp-db.env
# Every process that talks to hp-db (hp-sensors, hp-camera, hp-web) needs the same token.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HP_DB_TOKEN=change-me
# Optional: where hp-db listens. Default is quack:localhost (port 9494, this machine only).
#HP_DB_URI=quack:localhost:9494
