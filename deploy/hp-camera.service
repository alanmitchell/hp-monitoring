[Unit]
Description=Heat pump coil image capture (hp-camera)
Wants=network-online.target
# Start after the database when both start at boot. Not a hard dependency:
# hp-camera keeps saving images and spools their records whenever hp-db is down.
After=network-online.target hp-db.service
# Keep restarting forever; never give up after repeated failures
StartLimitIntervalSec=0

[Service]
Type=simple
# Adjust the user and the /home/alan paths if the mini-PC differs
User=alan
WorkingDirectory=/home/alan/hp-monitoring
# Holds RTSP_URL (contains the camera password); see config/hp-camera.example.env
EnvironmentFile=/home/alan/hp-monitoring/config/hp-camera.env
# Holds HP_DB_TOKEN; see config/hp-db.example.env
EnvironmentFile=/home/alan/hp-monitoring/config/hp-db.env
# Show print() output in the journal immediately
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/alan/hp-monitoring/.venv/bin/hp-camera
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
